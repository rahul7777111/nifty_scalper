+    def _event_realized_pnl(self, evt: TradeLogEvent) -> float | None:
+        try:
+            if evt.realized is not None:
+                return float(evt.realized)
+        except Exception:
+            pass
+
+        total = 0.0
+        any_leg = False
+        for leg in list(evt.legs or []):
+            if not isinstance(leg, dict):
+                continue
+            try:
+                side = str(leg.get("side") or "").strip().upper()
+                qty = int(leg.get("quantity") or 0)
+                entry = float(leg.get("entry_price"))
+                exit_raw = leg.get("exit_price")
+                if exit_raw is None:
+                    exit_raw = leg.get("ltp")
+                exit_price = float(exit_raw)
+            except Exception:
+                continue
+            if qty <= 0 or side not in {"BUY", "SELL"}:
+                continue
+            sign = 1.0 if side == "BUY" else -1.0
+            total += (float(exit_price) - float(entry)) * sign * float(abs(qty))
+            any_leg = True
+
+        return float(total) if any_leg else None
+
+    def _persist_completed_trade_event(self, evt: TradeLogEvent) -> None:
+        """Persist realized close events so terminal P&L can read trades.db."""
+
+        try:
+            if str(evt.event or "").upper() not in {"PARTIAL_CLOSE", "CLOSE"}:
+                return
+        except Exception:
+            return
+
+        db_manager = getattr(self, "_db_manager", None)
+        if db_manager is None:
+            try:
+                db_manager = DatabaseManager()
+                self._db_manager = db_manager
+            except Exception:
+                return
+
+        realized = self._event_realized_pnl(evt)
+        if realized is None:
+            return
+
+        try:
+            ts_key = round(float(evt.ts), 3)
+        except Exception:
+            ts_key = round(time.time(), 3)
+        dedupe_key = (str(evt.trade_id), str(evt.event), ts_key, round(float(realized), 4))
+        try:
+            if dedupe_key in self._persisted_trade_events:
+                return
+            self._persisted_trade_events.add(dedupe_key)
+        except Exception:
+            pass
+
+        legs = [leg for leg in list(evt.legs or []) if isinstance(leg, dict)]
+        symbols: list[str] = []
+        qty_total = 0
+        entries: list[float] = []
+        exits: list[float] = []
+        sides: set[str] = set()
+        for leg in legs:
+            sym = str(leg.get("symbol") or "").strip()
+            if sym and sym not in symbols:
+                symbols.append(sym)
+            try:
+                qty_total += abs(int(leg.get("quantity") or 0))
+            except Exception:
+                pass
+            side = str(leg.get("side") or "").strip().upper()
+            if side:
+                sides.add(side)
+            try:
+                if leg.get("entry_price") is not None:
+                    entries.append(float(leg.get("entry_price")))
+            except Exception:
+                pass
+            try:
+                exit_raw = leg.get("exit_price")
+                if exit_raw is None:
+                    exit_raw = leg.get("ltp")
+                if exit_raw is not None:
+                    exits.append(float(exit_raw))
+            except Exception:
+                pass
+
+        symbol = ", ".join(symbols[:3]) if symbols else str(evt.name or evt.position_type or "trade")
+        if len(symbols) > 3:
+            symbol = f"{symbol}, ..."
+        side = "/".join(sorted(sides)) if sides else str(evt.position_type or evt.event or "TRADE")
+        entry_price = (sum(entries) / len(entries)) if entries else 0.0
+        exit_price = (sum(exits) / len(exits)) if exits else 0.0
+        quantity = int(qty_total or 1)
+
+        try:
+            db_manager.insert_trade(
+                trade_id=str(evt.trade_id),
+                symbol=str(symbol),
+                side=str(side),
+                quantity=int(quantity),
+                entry_price=float(entry_price),
+                exit_price=float(exit_price),
+                realized_pnl=float(realized),
+            )
+        except Exception:
+            return
+

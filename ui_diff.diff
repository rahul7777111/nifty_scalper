+    def _prune_old_closed_trades(self, max_keep: int = 250) -> None:
+        """Remove old fully closed trades from tracking and the UI to prevent memory leaks and UI freezing."""
+        try:
+            # Gather fully CLOSED trade IDs. We rely on the fact that dict insertion order
+            # roughly matches chronological order in Python 3.7+.
+            closed_ids: list[str] = []
+            for trade_id, state in list(self._trade_state.items()):
+                if str(trade_id).endswith("-H"):
+                    # We prune hedges when we prune the original
+                    continue
+                st = str((state or {}).get("status") or "").strip().upper()
+                if st.startswith("CLOSED"):
+                    closed_ids.append(str(trade_id))
+
+            # Only prune if we have more than max_keep perfectly closed trades
+            if len(closed_ids) <= max_keep:
+                return
+
+            stale_ids = closed_ids[:-max_keep]
+
+            for trade_id in stale_ids:
+                try:
+                    row = self._trade_rows.pop(trade_id, None)
+                    if row is not None:
+                        self.trade_tree.delete(row)
+                except Exception:
+                    pass
+                try:
+                    self._trade_state.pop(trade_id, None)
+                except Exception:
+                    pass
+
+                hedge_trade_id = f"{trade_id}-H"
+                try:
+                    hedge_row = self._trade_rows.pop(hedge_trade_id, None)
+                    if hedge_row is not None:
+                        self.trade_tree.delete(hedge_row)
+                except Exception:
+                    pass
+                try:
+                    self._trade_state.pop(hedge_trade_id, None)
+                except Exception:
+                    pass
+        except Exception:
+            pass
+
